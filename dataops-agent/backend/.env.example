# ── App ──────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-secret
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:3000

# ── Database ──────────────────────────────────────
# DATABASE_URL / SYNC_DATABASE_URL MUST connect as dataops_app (NOSUPERUSER,
# NOBYPASSRLS) -- these are the runtime roles the backend and both Celery
# services actually use to serve requests. Pointing them at dataops_user
# instead would leave every RLS policy in place but completely inert:
# superuser/BYPASSRLS roles silently bypass Row-Level Security regardless of
# FORCE ROW LEVEL SECURITY. See migration b7d419e3f2a8 and CLAUDE.md's
# Auth/tenancy section.
DATABASE_URL=postgresql+asyncpg://dataops_app:changeme@127.0.0.1:5432/dataops
SYNC_DATABASE_URL=postgresql+psycopg2://dataops_app:changeme@127.0.0.1:5432/dataops
# Privileged URL -- dataops_user (superuser/owner). Used ONLY by Alembic
# migrations, test_schema_drift.py / test_source_test_connection.py (which
# need CREATE DATABASE / cross-tenant introspection), and maintenance
# scripts (services/audit_anchor.py). Never by a request-serving or Celery
# code path -- there is a regression test asserting exactly that.
ADMIN_DATABASE_URL=postgresql+psycopg2://dataops_user:changeme@127.0.0.1:5432/dataops
# Password the RLS migration provisions the dataops_app role with. Must
# match the password used in DATABASE_URL/SYNC_DATABASE_URL above.
APP_DB_PASSWORD=changeme

# ── Redis / Celery ────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── LLM Keys ──────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here
PRIMARY_LLM_PROVIDER=gemini
PRIMARY_LLM_MODEL=gemini-3.5-flash
FALLBACK_LLM_PROVIDER=groq
FALLBACK_LLM_MODEL=openai/gpt-oss-120b
# GDPR data residency (Security Master Ranking Item #11). One of:
# global | eu | self_hosted -- "eu" and "self_hosted" are NOT IMPLEMENTED
# and deliberately refuse every outbound LLM call rather than silently
# falling back to the global providers. See config.py's own comment.
LLM_DATA_RESIDENCY_MODE=global
LLM_SELF_HOSTED_ENDPOINT=

# ── Auth ──────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# Fernet key encrypting DataSource.connection_config at rest (Security
# Master Ranking Item #1). Must be a real, generated Fernet key outside
# development/tests -- services/encryption_service.py refuses to boot
# without one. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# ── Google OAuth (optional) ───────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# ── Enterprise SSO via WorkOS (optional, Item #14) ─
# Empty means SSO is not configured for this deployment -- /auth/sso/*
# answers 503 rather than pretending. WORKOS_TEST_CONNECTION_ID is the
# staging Test Identity Provider's connection id, used only by the live
# round-trip script and tests, never by a real customer tenant.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_TEST_CONNECTION_ID=
SSO_REDIRECT_URI=http://localhost:3000/api/auth/callback/sso

# ── MFA / TOTP (Item #13) ─────────────────────────
MFA_GRACE_DAYS=7
MFA_ISSUER=Wunomo

# ── Email (optional) ──────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=axiom@dataops.ai
SMTP_USE_TLS=true
EMAIL_FROM=
RESEND_API_KEY=
ALERT_EMAIL=
# Item #9 follow-up: where the daily audit-chain tail hashes are mailed.
# Empty means "not anchored" -- the daily task logs an ERROR every run
# until this is set. The local file it also writes (AUDIT_ANCHOR_LOG_PATH)
# is a convenience copy on the same host, not an anchor.
ANCHOR_NOTIFICATION_EMAIL=
AUDIT_ANCHOR_LOG_PATH=audit_chain_anchors.log

# ── Slack (optional) ──────────────────────────────
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=#dataops-alerts
SLACK_WEBHOOK_URL=

# ── Feature Flags ─────────────────────────────────
ENABLE_AUTONOMOUS_MODE=false
ENABLE_DESTRUCTIVE_ACTIONS=false
MAX_PIPELINE_RETRIES=3
MAX_ROWS_PER_PREVIEW=1000

# ── Demo scripts (scripts/demo_reset.mjs etc, optional) ──
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=change-me-to-a-real-demo-password

# ── Test suite escape hatches (optional, never set outside a local debug
#    session) ──
# Keeps every tenant a test run creates instead of the usual teardown, for
# inspecting a failed run's data afterwards. See tests/conftest.py.
AXIOM_KEEP_TEST_DATA=
