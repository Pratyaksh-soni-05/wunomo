# ── App ──────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-secret
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Database ──────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://dataops_user:changeme@127.0.0.1:5432/dataops
SYNC_DATABASE_URL=postgresql+psycopg2://dataops_user:changeme@127.0.0.1:5432/dataops

# ── Redis / Celery ────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── LLM Keys ──────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here
PRIMARY_LLM_PROVIDER=gemini
PRIMARY_LLM_MODEL=gemini-3.5-flash
FALLBACK_LLM_MODEL=llama-3.3-70b-versatile

# ── Auth ──────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Email (optional) ──────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Slack (optional) ──────────────────────────────
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=#dataops-alerts

# ── Feature Flags ─────────────────────────────────
ENABLE_AUTONOMOUS_MODE=false
ENABLE_DESTRUCTIVE_ACTIONS=false
MAX_PIPELINE_RETRIES=3
MAX_ROWS_PER_PREVIEW=1000